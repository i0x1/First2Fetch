# Supabase Configuration
# For local development: http://127.0.0.1:54321
# For Supabase Cloud: https://YOUR_PROJECT_REF.supabase.co
# When deployed, use Dashboard → Edge Functions → Secrets instead
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Azure AI Foundry Configuration (for OpenAI/LLM functionality)
# Required for job description parsing and AI features
# Get these from your Azure AI Foundry resource
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=

# Stripe Configuration
# Required for payment processing and subscription management
# Get these from your Stripe dashboard (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe dashboard (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SIGNING_SECRET=

# Email Service Configuration (Resend — job alerts + scan failure emails)
# Auth emails (signup confirm, password reset) use Supabase Auth SMTP (configure in Dashboard).
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender/domain in Resend (same domain you linked to Supabase SMTP).
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=First 2 Apply

# MailerLite API key (optional - for email marketing/newsletter)
# Get from https://developers.mailerlite.com/docs
MAILERLITE_API_KEY=

# Logging and Monitoring (Mezmo / LogDNA)
# Optional API key — Edge functions log to stdout by default (visible in Supabase Dashboard).
# The @logdna client can crash hosted Edge with connection errors unless explicitly enabled:
# MEZMO_ENABLE_EDGE=true
# Get from https://www.mezmo.com/
MEZMO_API_KEY=
# MEZMO_ENABLE_EDGE=true

# Webhook Security
# Secret key for signing webhooks (use a strong random string)
# This should be a secure random string that matches your webhook configuration
F2A_WEBHOOK_SECRET="my-super-secret-webhook-signing-secret"
