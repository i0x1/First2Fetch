# Application Bundle ID
# Unique identifier for the Electron app (e.g., for macOS)
# Format: reverse domain notation (e.g., 'ro.beastx.first2apply.dev' for dev, 'ro.beastx.first2apply' for prod)
APP_BUNDLE_ID='ro.beastx.first2fetch.dev'

# Supabase Configuration
# URL of your Supabase instance
# For local development (Docker): http://127.0.0.1:54321
# For Supabase Cloud (recommended): https://YOUR_PROJECT_REF.supabase.co
# See docs/SUPABASE_CLOUD_MIGRATION.md for migration guide
SUPABASE_URL='http://127.0.0.1:54321'

# Supabase Anon/Public Key
# Get from Supabase Dashboard → Settings → API
# Use anon/public key (not service_role key)
SUPABASE_KEY=

# Logging and Monitoring
# Mezmo API key for log aggregation and monitoring
# Get from https://www.mezmo.com/
MEZMO_API_KEY=

# Analytics
# Amplitude API key for user analytics
# Get from https://amplitude.com/
AMPLITUDE_API_KEY=

# macOS Code Signing (Optional - only needed for production builds)
# Apple Developer credentials for code signing and notarization
# Required when publishing macOS builds
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
